// MongoDB Playground for E-commerce Analytics
// This file contains sample queries and aggregations for exploring your e-commerce data
// To run a query: Click the "Run" button above each section or press Ctrl+Shift+R

// ==========================================
// SETUP: Connect to your database
// ==========================================
use('documentdb');

// ==========================================
// PRODUCTS QUERIES
// ==========================================

// 1. Find all products
db.products.find({});

// 2. Find electronics products
db.products.find({ category: "Electronics" });

// 3. Find products with low stock (less than 10)
db.products.find({ stock_quantity: { $lt: 10 } });

// 4. Find products by price range ($50-$200)
db.products.find({
  price: { $gte: 50, $lte: 200 }
});

// 5. Search products by name (case-insensitive)
db.products.find({
  name: { $regex: "wireless", $options: "i" }
});

// 6. Count products by category
db.products.aggregate([
  {
    $group: {
      _id: "$category",
      count: { $sum: 1 },
      avgPrice: { $avg: "$price" },
      totalStock: { $sum: "$stock_quantity" }
    }
  },
  { $sort: { count: -1 } }
]);

// ==========================================
// CUSTOMERS QUERIES
// ==========================================

// 7. Find all active customers
db.customers.find({ is_active: true });

// 8. Find customers by city
db.customers.find({
  "address.city": "San Francisco"
});

// 9. Search customers by name
db.customers.find({
  $or: [
    { first_name: { $regex: "john", $options: "i" } },
    { last_name: { $regex: "john", $options: "i" } }
  ]
});

// 10. Customer spending analysis
db.orders.aggregate([
  {
    $group: {
      _id: "$customer_email",
      totalOrders: { $sum: 1 },
      totalSpent: { $sum: "$total_amount" },
      avgOrderValue: { $avg: "$total_amount" },
      lastOrderDate: { $max: "$created_at" }
    }
  },
  { $sort: { totalSpent: -1 } },
  { $limit: 10 }
]);

// ==========================================
// PERFORMANCE & INDEXES
// ==========================================

// 11. Check indexes on products collection
db.products.getIndexes();

// 12. Check indexes on customers collection
db.customers.getIndexes();

// 13. Explain query plan (shows if indexes are used)
db.products.find({ category: "Electronics" }).explain("executionStats");

// ==========================================
// DATA QUALITY CHECKS
// ==========================================

// 14. Find products with missing or null descriptions
db.products.find({
  $or: [
    { description: null },
    { description: "" },
    { description: { $exists: false } }
  ]
});

// 15. Find customers without addresses
db.customers.find({
  $or: [
    { address: null },
    { address: { $exists: false } }
  ]
});

// ==========================================
// USEFUL AGGREGATION PATTERNS
// ==========================================

// 16. Bucket products by price range
db.products.aggregate([
  {
    $bucket: {
      groupBy: "$price",
      boundaries: [0, 50, 100, 200, 500, 1000],
      default: "Over 1000",
      output: {
        count: { $sum: 1 },
        products: { $push: "$name" }
      }
    }
  }
]);

// 17. Find duplicate SKUs (data quality check)
db.products.aggregate([
  {
    $group: {
      _id: "$sku",
      count: { $sum: 1 },
      products: { $push: "$name" }
    }
  },
  {
    $match: { count: { $gt: 1 } }
  }
]);