# Database Configuration
# TODO: Replace USERNAME and PASSWORD with your actual DocumentDB credentials.
DOCUMENTDB_URL=mongodb://USERNAME:PASSWORD@host.docker.internal:10260/?tls=true&tlsAllowInvalidCertificates=true&authMechanism=SCRAM-SHA-256

# TODO: Add your database name (suggested: ecommerce)
DOCUMENTDB_DB_NAME=TODO_ADD_YOUR_DATABASE_NAME

# DocumentDB Credentials
# TODO: Add your DocumentDB username (should match the connection string above)
DOCUMENTDB_USERNAME=TODO_ADD_YOUR_USERNAME

# TODO: Add your DocumentDB password (should match the connection string above)
DOCUMENTDB_PASSWORD=TODO_ADD_YOUR_PASSWORD

# Application Settings
APP_NAME=FastAPI E-Commerce
APP_VERSION=1.0.0
DEBUG=true
RELOAD=true

# API Settings
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
