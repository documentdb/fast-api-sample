MONGODB_URL=TODO_ADD_YOUR_MONGODB_CONNECTION_STRING

# TODO: Add your database name (suggested: ecommerce)
MONGODB_DB_NAME=TODO_ADD_YOUR_DATABASE_NAME

# DocumentDB Credentials
